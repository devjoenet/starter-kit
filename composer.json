{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "devjoenet/starter-kit",
  "type": "project",
  "description": "The starter application for Southeast Code Laravel projects.",
  "keywords": [
    "laravel",
    "vue",
    "inertia",
    "starter-kit",
    "southeast-code"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "inertiajs/inertia-laravel": "^3.0",
    "laravel/fortify": "^1.37.2",
    "laravel/framework": "^13.7",
    "laravel/tinker": "^3.0",
    "laravel/wayfinder": "^0.1.14"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "larastan/larastan": "^3.10",
    "laravel/boost": "^2.4",
    "laravel/pail": "^1.2.5",
    "laravel/pao": "^1.0.6",
    "laravel/pint": "^1.27",
    "laravel/sail": "^1.53",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.9.3",
    "phpunit/phpunit": "^12.5.23",
    "rector/rector": "^2.4"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "setup": [
      "composer install",
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
      "@php artisan key:generate",
      "@php artisan migrate --force",
      "npm install",
      "npm run build"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve --host=localhost\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
    ],
    "lint": [
      "pint --parallel"
    ],
    "lint:check": [
      "pint --parallel --test"
    ],
    "rector": [
      "rector"
    ],
    "rector:check": [
      "rector --dry-run"
    ],
    "phpstan": [
      "phpstan analyse"
    ],
    "phpstan:check": [
      "phpstan analyse --no-progress"
    ],
    "ci:check": [
      "Composer\\Config::disableProcessTimeout",
      "@rector:check",
      "@phpstan:check",
      "npm run lint:check",
      "npm run format:check",
      "@php artisan wayfinder:generate --with-form --no-interaction",
      "npm run types:check",
      "@test"
    ],
    "test": [
      "@php artisan config:clear --ansi",
      "@lint:check",
      "@php artisan test"
    ],
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php artisan migrate --graceful --ansi"
    ],
    "pre-package-uninstall": [
      "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": [],
      "installer": {
        "post-create-project": []
      }
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
